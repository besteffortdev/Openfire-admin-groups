<?xml version="1.0" encoding="UTF-8"?>
<assembly xmlns="http://maven.apache.org/ASSEMBLY/2.1.1"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/ASSEMBLY/2.1.1
                              http://maven.apache.org/xsd/assembly-2.1.1.xsd">
    <id>openfire-plugin</id>
    <formats>
        <format>jar</format>
    </formats>
    <includeBaseDirectory>false</includeBaseDirectory>

    <!-- plugin.xml + readme.html at the archive root.
         Openfire shows the "readme" (documentation) link on the Plugins admin page
         when readme.html is present at the plugin root, next to plugin.xml. -->
    <files>
        <!--
            The FILTERED plugin.xml from target/classes, not the one in src/main/resources: only
            this copy has ${project.version} resolved to a real version number.
        -->
        <file>
            <source>${project.build.outputDirectory}/plugin.xml</source>
            <outputDirectory>/</outputDirectory>
        </file>
        <file>
            <source>src/main/resources/readme.html</source>
            <outputDirectory>/</outputDirectory>
        </file>
        <!--
            The web.xml that ships is the MERGED one jetty-ee8-jspc-maven-plugin writes to
            target/, not the source under src/main/webapp/WEB-INF. Only the merged copy contains
            the <servlet>/<servlet-mapping> entries for the precompiled page, and Openfire's
            PluginServlet serves a JSP purely by looking it up there.
        -->
        <file>
            <source>${project.build.directory}/web.xml</source>
            <outputDirectory>web/WEB-INF</outputDirectory>
            <destName>web.xml</destName>
        </file>
    </files>

    <!-- Static admin-console assets; the .jsp itself is compiled into the classes jar. -->
    <fileSets>
        <fileSet>
            <directory>src/main/webapp</directory>
            <outputDirectory>web</outputDirectory>
            <excludes>
                <exclude>**/*.jsp</exclude>
                <exclude>**/*.jspf</exclude>
                <exclude>WEB-INF/web.xml</exclude>
            </excludes>
        </fileSet>
    </fileSets>

    <!--
        The compiled classes JAR goes into lib/. Exactly one entry on purpose: this plugin bundles
        no runtime dependency, and the provided-scope ones are already on Openfire's classloader.
    -->
    <dependencySets>
        <dependencySet>
            <outputDirectory>lib</outputDirectory>
            <useProjectArtifact>true</useProjectArtifact>
            <useTransitiveDependencies>false</useTransitiveDependencies>
            <includes>
                <include>${project.groupId}:${project.artifactId}</include>
            </includes>
        </dependencySet>
    </dependencySets>
</assembly>
